# MCP/KB runtime settings for precice-ai
EMBED_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3

# Only needed when EMBED_PROVIDER=api (OpenAI-compatible embedding API,
# OpenRouter by default). Not required for the default local mode.
OPENROUTER_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

GITHUB_TOKEN=
