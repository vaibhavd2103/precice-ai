# MCP/KB runtime settings for precice-ai
#
# Semantic KB queries embed the question through an OpenAI-compatible
# embeddings API, so one of these keys is required:
OPENROUTER_API_KEY=
# BLABLADOR_API_KEY=

# Optional overrides. Defaults: OpenRouter endpoint (or the Blablador
# endpoint if only BLABLADOR_API_KEY is set) and openai/text-embedding-3-small.
# The model MUST match the one the published KB was built with.
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=openai/text-embedding-3-small

GITHUB_TOKEN=
